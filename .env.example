# Kopiera den här filen till .env och fyll i riktiga värden.
# .env checkas aldrig in i git (se .gitignore).

# Integrationens databas
POSTGRES_USER=integration
POSTGRES_PASSWORD=byt-mig
POSTGRES_DB=integration

# Shopify: hemligheten som webhooks signeras med
SHOPIFY_WEBHOOK_SECRET=byt-mig

# Mini-ERP
ERP_DB_USER=erp
ERP_DB_PASSWORD=byt-mig
ERP_DB_NAME=erp
ERP_API_KEY=byt-mig

# Felbrytare: none (normal), down (svarar 503) eller slow (svarar långsamt)
ERP_FAILURE_MODE=none
ERP_SLOW_SECONDS=10
